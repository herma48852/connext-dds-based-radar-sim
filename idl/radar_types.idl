// ============================================================================
// AESA SPY-6 class radar simulation - shared DDS type system
//
// Design notes (Connext Studio visibility):
//  - All application types are @appendable: fields can be added in future
//    releases without breaking interoperability with older participants.
//    The builtin TypeLookup Service (enabled by default in Connext 7.x)
//    makes these types fully self-describing, so monitoring tools such as
//    Connext Studio can decode samples without access to this IDL file.
//  - Verbose field names and comments are intentional - they are what
//    Connext Studio's data inspector shows for each sample.
//  - Every topic carries a timestamp and (directly or via ship-relative
//    coordinates) the ship's GPS/INS state, because the radar is mounted
//    on a moving naval vessel.
//
// Coordinate frames:
//  - Ship-relative polar  : range (m), azimuth (deg, 0 = bow, CW positive),
//                           elevation (deg, + = up)
//  - Ship-relative ENU    : x = east (m), y = north (m), z = up (m),
//                           origin at the ship's own position
// ============================================================================

module radar {
module types {

    // ---- Bounds ------------------------------------------------------------
    const long MAX_RANGE_BINS      = 2048;  // scalar I/Q values per beam dwell
    const long MAX_ARRAY_ELEMENTS  = 1024;  // T/R modules in the array face
    const long MAX_BEAM_PATTERN_SAMPLES = 181; // -45..+45 deg azimuth cut
    const long COVARIANCE_SIZE     = 9;     // 3x3 position covariance, row-major
    const long MAX_PARAMS_LEN      = 128;   // free-form command parameter string
    const long MAX_SCENARIO_NAME_LEN = 64;
    const long MAX_SCENARIO_LABEL_LEN = 64;
    const long MAX_SCENARIO_DESCRIPTION_LEN = 256;
    const long MAX_TARGET_CONTROL_MESSAGE_LEN = 256;
    const long MAX_TARGET_SCENARIO_TEMPLATES = 32;
    const long MAX_TARGET_SCENARIO_INSTANCES = 256;
    const long MAX_TARGET_CONTROL_TARGETS = 256;
    // A resolution-cell fusion normally combines one or two plots. Keep the
    // diagnostic lineage payload bounded even when a malformed publisher
    // floods one cell; contributor_count/truncated make overflow explicit.
    const long MAX_ASSOCIATION_DETECTIONS = 32;

    // Four fixed ship-relative array faces, numbered clockwise from the
    // forward-starboard quadrant. Face-local topics keep their existing
    // signed-long key fields for wire compatibility; these constants define
    // the bounded key space used by those fields.
    const long FACE_FORWARD_STARBOARD = 0;  // boresight 045 deg, covers 000..090
    const long FACE_AFT_STARBOARD     = 1;  // boresight 135 deg, covers 090..180
    const long FACE_AFT_PORT          = 2;  // boresight 225 deg, covers 180..270
    const long FACE_FORWARD_PORT      = 3;  // boresight 315 deg, covers 270..360
    const long FACE_COUNT             = 4;

    // SystemCommand.target_face_mask bits. A zero mask is reserved as the
    // legacy/default encoding for the forward-starboard face.
    const long FACE_MASK_FORWARD_STARBOARD = 1;
    const long FACE_MASK_AFT_STARBOARD     = 2;
    const long FACE_MASK_AFT_PORT          = 4;
    const long FACE_MASK_FORWARD_PORT      = 8;
    const long FACE_MASK_ALL               = 15;

    // ---- Common primitives -------------------------------------------------

    // Dual time base: wall clock for correlation with external tools,
    // simulation clock for deterministic replay.
    struct TimeStamp {
        long long epoch_millis;  // Unix epoch time [ms]
        long      sim_millis;    // time since simulation start [ms]
    };

    // WGS-84 geodetic position (own-ship GPS/INS solution)
    @appendable
    struct GeoPosition {
        double latitude_deg;
        double longitude_deg;
        double altitude_m;
    };

    // Cartesian vector in ship-relative ENU coordinates [m] / [m/s] / [m/s^2]
    @appendable
    struct Cartesian3D {
        double x_east_m;
        double y_north_m;
        double z_up_m;
    };

    // ---- Enumerations --------------------------------------------------------

    enum BeamMode {
        BEAM_MODE_SEARCH,     // volume search dwell
        BEAM_MODE_TRACK,      // dedicated track update dwell
        BEAM_MODE_CONFIRM,    // detection confirmation dwell
        BEAM_MODE_CALIBRATE   // array calibration dwell
    };

    enum TrackClassification {
        CLASS_UNKNOWN,
        CLASS_AIR_BREATHING,  // aircraft-like kinematics
        CLASS_BALLISTIC,      // ballistic trajectory
        CLASS_SURFACE,        // surface contact
        CLASS_CLUTTER         // assessed false alarm
    };

    // Authoritative TrackManager decision telemetry. Association is emitted
    // after the production gate/filter path, so diagnostic consumers do not
    // need to duplicate tracker algorithms or private state.
    enum TrackAssociationDecision {
        TRACK_ASSOCIATION_INITIATE,
        TRACK_ASSOCIATION_UPDATE,
        TRACK_ASSOCIATION_REJECT,
        TRACK_ASSOCIATION_MERGE,
        TRACK_ASSOCIATION_DROP
    };

    enum TrackAssociationReason {
        TRACK_ASSOCIATION_REASON_NONE,
        TRACK_ASSOCIATION_REASON_CAPACITY,
        TRACK_ASSOCIATION_REASON_DUPLICATE,
        TRACK_ASSOCIATION_REASON_COAST_TIMEOUT,
        TRACK_ASSOCIATION_REASON_RESET,
        TRACK_ASSOCIATION_REASON_SHUTDOWN
    };

    enum ArrayHealth {
        ARRAY_NOMINAL,        // all elements within tolerance
        ARRAY_DEGRADED,       // some elements failed, beam quality reduced
        ARRAY_CRITICAL,       // too many failures, transmit inhibited
        ARRAY_OFFLINE         // array in standby / self-test
    };

    enum CommandType {
        CMD_SET_MODE,         // change radar operating mode
        CMD_SET_SECTOR,       // reprioritize a search sector
        CMD_SELF_TEST,        // run built-in self test
        CMD_RESET,            // reset tracks and restart scan
        CMD_DEGRADE_ARRAY,    // demo: inject element failures
        CMD_RESTORE_ARRAY,    // demo: restore array to nominal
        CMD_RMA_OFFLINE,      // take a Radar Modular Assembly out of service
        CMD_RMA_ONLINE        // return a Radar Modular Assembly to service
    };

    enum TargetType {
        TARGET_FIGHTER,
        TARGET_BOMBER,
        TARGET_MISSILE,
        TARGET_SHIP,
        TARGET_DRONE,
        TARGET_DECOY
    };

    // Out-of-band target-generator management. These types are used only on
    // target_gen's separate control domain, never on the radar data domain.
    enum TargetControlAction {
        TARGET_CONTROL_ADD_SCENARIO,
        TARGET_CONTROL_REMOVE_SCENARIO,
        TARGET_CONTROL_REMOVE_TARGET,
        TARGET_CONTROL_CLEAR_ALL
    };

    enum TargetControlResult {
        TARGET_CONTROL_ACCEPTED,
        TARGET_CONTROL_REJECTED
    };

    // ---- Topic types ---------------------------------------------------------

    // Ship GPS/INS position and motion. Published by the radar's INS
    // (source_id = 0) and as ground truth by the target generator
    // (source_id = 1), keyed so both coexist on the same topic.
    @appendable
    struct ShipPosition {
        @key long   source_id;      // 0 = own-ship INS, 1 = ground truth
        TimeStamp   timestamp;
        double      latitude_deg;   // WGS-84 latitude  [deg]
        double      longitude_deg;  // WGS-84 longitude [deg]
        double      altitude_m;     // height above WGS-84 ellipsoid [m]
        double      heading_deg;    // true heading [deg]
        double      course_deg;     // course over ground [deg]
        double      speed_mps;      // speed over ground [m/s]
        double      pitch_deg;      // INS attitude, pitch [deg]
        double      roll_deg;       // INS attitude, roll  [deg]
    };

    // Beam steering request issued by the BeamScheduler. One bounded keyed
    // instance exists per array face; scheduler_id uses FACE_* (0..3).
    // Keying by incrementing beam_id would create unbounded DDS instances.
    @appendable
    struct BeamCommand {
        @key long   scheduler_id;   // FACE_*: array face / scheduler instance
        long        beam_id;        // monotonically increasing dwell id
        TimeStamp   timestamp;
        double      azimuth_deg;    // commanded azimuth, ship-relative [deg]
        double      elevation_deg;  // commanded elevation [deg]
        long        dwell_time_us;  // dwell duration [microseconds]
        BeamMode    mode;           // dwell purpose
        long        priority;       // 1 = highest
    };

    // Current outage-aware azimuth response of the array. Published at
    // 20 Hz per face (80 Hz aggregate) by Beamformer and consumed by
    // DetectionProcessor and HMI-UI.
    // The bounded sequence is a normalized dB cut relative to the active
    // aperture's peak; scalar fields make Studio time charts inexpensive.
    @appendable
    struct BeamPatternStatus {
        @key long   array_id;       // FACE_*: one instance per array face
        TimeStamp   timestamp;
        long        beam_id;
        long        rma_offline_mask;
        double      commanded_azimuth_deg; // ship-relative
        double      boresight_error_deg;   // effective - commanded
        double      gain_loss_db;          // relative to all 1024 elements
        double      beamwidth_3db_deg;
        double      peak_sidelobe_level_db; // relative to active peak
        double      left_sidelobe_offset_deg;
        double      right_sidelobe_offset_deg;
        double      pattern_start_offset_deg;
        double      pattern_step_deg;
        sequence<float, MAX_BEAM_PATTERN_SAMPLES> azimuth_pattern_db;
        // Representative, unclassified RF/search-waveform configuration.
        double      carrier_frequency_hz;
        double      wavelength_m;
        double      element_pitch_m;
        double      waveform_bandwidth_hz;
        double      pulse_repetition_frequency_hz;
        double      pulse_width_sec;
        double      range_resolution_m;
        double      unambiguous_range_m;
    };

    // Simulated raw receiver output for one beam dwell.
    // High-rate (1 kHz per face, 4 kHz aggregate), best-effort: four
    // post-beamforming "wires" between receiver and signal processor,
    // exposed as one keyed topic for monitoring purposes.
    // Keyed by the bounded FACE_* array id. Keying by incrementing beam_id
    // would register a new DDS instance per sample (unbounded growth).
    @appendable
    struct RawReturn {
        @key long             array_id;      // FACE_*: post-beamforming I/Q stream
        long                  beam_id;       // dwell this return belongs to
        TimeStamp             timestamp;
        double                azimuth_deg;   // beam pointing direction [deg]
        double                elevation_deg;
        long                  range_bin_count; // complex cells; 2 I/Q values each
        sequence<float, MAX_RANGE_BINS> iq_samples; // interleaved I,Q per bin
    };

    // Single threshold-crossing detection report (a "blip").
    // Keyed by bounded FACE_* sensor id: an incrementing detection key would
    // leak one DDS instance per blip.
    @appendable
    struct DetectionEvent {
        @key long     sensor_id;      // FACE_*: detecting array face
        long          detection_id;   // unique detection number
        TimeStamp     timestamp;
        GeoPosition   ship_position;  // own-ship GPS/INS at detection time
        double        range_m;        // ship-relative range [m]
        double        azimuth_deg;    // ship-relative azimuth [deg]
        double        elevation_deg;  // ship-relative elevation [deg]
        double        amplitude;      // linear amplitude of the return
        double        snr_db;         // signal-to-noise ratio [dB]
        long          beam_id;        // producing RawReturn dwell id
    };

    // Correlated, filtered target track maintained by the TrackManager.
    @appendable
    struct TargetTrack {
        @key long               track_id;      // persistent track number
        TimeStamp               timestamp;
        Cartesian3D             position;      // ship-relative ENU [m]
        Cartesian3D             velocity;      // ship-relative ENU [m/s]
        Cartesian3D             acceleration;  // ship-relative ENU [m/s^2]
        sequence<double, COVARIANCE_SIZE> covariance; // 3x3 pos covariance
        TrackClassification     classification;
        long                    quality;       // track quality score 0..100
    };

    // Stable identity for every source plot absorbed by a fused tracker
    // measurement. It remains meaningful after the keyed DetectionEvent
    // instance has advanced to newer data.
    @appendable
    struct AssociationDetectionIdentity {
        long      sensor_id;
        long      detection_id;
        long      beam_id;
        TimeStamp timestamp;
    };

    // One event per authoritative tracker decision. tracker_id is a bounded
    // DDS key (one TrackManager instance in this simulation); association_id
    // is deliberately non-key. Numeric TargetTrack ids are recycled, so a
    // lifecycle is uniquely identified by tracker_instance_id plus
    // track_lifecycle_id.
    @appendable
    struct TrackAssociationEvent {
        @key long               tracker_id;
        long long               association_id;
        TimeStamp               timestamp;
        long long               tracker_instance_id;
        long                    track_id; // -1 for a rejected measurement
        long long               track_lifecycle_id;
        long                    related_track_id; // merged/dropped fragment
        long long               related_track_lifecycle_id;
        TrackAssociationDecision decision;
        TrackAssociationReason   reason;
        boolean                 has_measurement;
        sequence<AssociationDetectionIdentity,
                 MAX_ASSOCIATION_DETECTIONS> contributing_detections;
        long                    contributor_count;
        boolean                 contributors_truncated;
        double                  fused_range_m;
        double                  fused_azimuth_deg;
        double                  fused_elevation_deg;
        double                  fused_snr_db;
        double                  innovation_score;
        long                    passing_candidate_count;
        boolean                 track_confirmed;
        long long               last_accepted_sim_millis;
    };

    // Phased-array health and calibration report (1 Hz per face + changes).
    @appendable
    struct CalibrationStatus {
        @key long   array_id;       // FACE_*: one instance per array face
        TimeStamp   timestamp;
        double      temperature_c;  // array face temperature [deg C]
        sequence<float, MAX_ARRAY_ELEMENTS> element_drift_db; // per-element gain drift
        ArrayHealth overall_status;
        long        failed_element_count;
        long        rma_offline_mask; // bit i = RMA i offline (16 RMAs x 64 elements)
    };

    // Operator / external system command into the radar.
    @appendable
    struct SystemCommand {
        @key long   command_id;
        TimeStamp   timestamp;
        CommandType command_type;
        double      sector_center_deg; // azimuth of prioritized sector [deg]
        double      sector_width_deg;  // sector width [deg]
        long        priority;          // 1 = highest
        string<MAX_PARAMS_LEN> parameters; // self-test / mode parameters
        long        target_face_mask;  // FACE_MASK_* bits; 0 = legacy forward-starboard
    };

    // Ground-truth target state published by the target generator.
    // The radar app never displays truth directly; it is only used by the
    // DetectionProcessor to synthesize physically-plausible raw returns.
    @appendable
    struct TargetTruth {
        @key long   target_id;
        TimeStamp   timestamp;
        Cartesian3D position;      // ship-relative ENU [m]
        Cartesian3D velocity;      // ship-relative ENU [m/s]
        Cartesian3D acceleration;  // ship-relative ENU [m/s^2]
        double      rcs_dbsm;      // radar cross section [dBsm]
        TargetType  target_type;
    };

    // Dynamically advertised scenario catalog entry. target_control renders
    // this catalog without hard-coding one widget layout per future scenario.
    @appendable
    struct TargetScenarioTemplateDescriptor {
        string<MAX_SCENARIO_NAME_LEN> name;
        string<MAX_SCENARIO_LABEL_LEN> label;
        string<MAX_SCENARIO_DESCRIPTION_LEN> description;
        boolean configurable_target_count;
        long default_target_count;
        long minimum_target_count;
        long maximum_target_count;
    };

    @appendable
    struct TargetScenarioInstanceState {
        long long scenario_instance_id;
        string<MAX_SCENARIO_NAME_LEN> template_name;
        long target_count;
    };

    @appendable
    struct TargetControlTargetState {
        long target_id;
        long long scenario_instance_id;
        TargetType target_type;
        Cartesian3D position;       // current ship-relative ENU [m]
        Cartesian3D velocity;       // current ship-relative ENU [m/s]
        double range_m;
    };

    // Unkeyed request/reply topics avoid leaking one DDS instance per click.
    // client_id and request_id correlate replies when multiple UIs coexist.
    @appendable
    struct TargetControlRequest {
        long client_id;
        long long request_id;
        TimeStamp timestamp;
        TargetControlAction action;
        string<MAX_SCENARIO_NAME_LEN> scenario_template;
        long long scenario_instance_id;
        long target_id;
        long target_count;
    };

    @appendable
    struct TargetControlReply {
        long client_id;
        long long request_id;
        TimeStamp timestamp;
        TargetControlResult result;
        long long scenario_instance_id;
        string<MAX_TARGET_CONTROL_MESSAGE_LEN> message;
    };

    // Last-value snapshot is transient-local so a restarted UI immediately
    // reconstructs the catalog and complete live inventory.
    @appendable
    struct TargetControlSnapshot {
        @key long generator_id;
        TimeStamp timestamp;
        long long revision;
        sequence<TargetScenarioTemplateDescriptor,
                 MAX_TARGET_SCENARIO_TEMPLATES> catalog;
        sequence<TargetScenarioInstanceState,
                 MAX_TARGET_SCENARIO_INSTANCES> scenarios;
        sequence<TargetControlTargetState,
                 MAX_TARGET_CONTROL_TARGETS> targets;
    };

}; // module types
}; // module radar
