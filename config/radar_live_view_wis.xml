<?xml version="1.0" encoding="UTF-8"?>
<!--
  Web Integration Service configuration for the Section 4 live views in
  docs/multi_topic_live_views/. Each named web_integration_service contains
  exactly one page application so launching one view creates one DDS
  participant and only that view's readers.

  The domain is 92 to match scripts/windows/start-all.cmd and
  scripts/start-all.sh defaults.

  RawReturn and BeamPatternStatus are appendable DDS types. Their reader-side
  definitions below intentionally stop before the large trailing sequences.
  XTypes assignability lets these projections match the complete writers while
  preventing iq_samples and azimuth_pattern_db from being serialized to JSON.
-->
<dds xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
     xsi:noNamespaceSchemaLocation="http://community.rti.com/schema/latest/rti_web_integration_service.xsd">

  <types>
    <module name="radar">
      <module name="types">
        <struct name="TimeStamp">
          <member name="epoch_millis" type="int64"/>
          <member name="sim_millis" type="int32"/>
        </struct>

        <struct name="GeoPosition" extensibility="appendable">
          <member name="latitude_deg" type="float64"/>
          <member name="longitude_deg" type="float64"/>
          <member name="altitude_m" type="float64"/>
        </struct>

        <struct name="Cartesian3D" extensibility="appendable">
          <member name="x_east_m" type="float64"/>
          <member name="y_north_m" type="float64"/>
          <member name="z_up_m" type="float64"/>
        </struct>

        <enum name="BeamMode">
          <enumerator name="BEAM_MODE_SEARCH"/>
          <enumerator name="BEAM_MODE_TRACK"/>
          <enumerator name="BEAM_MODE_CONFIRM"/>
          <enumerator name="BEAM_MODE_CALIBRATE"/>
        </enum>

        <enum name="TrackClassification">
          <enumerator name="CLASS_UNKNOWN"/>
          <enumerator name="CLASS_AIR_BREATHING"/>
          <enumerator name="CLASS_BALLISTIC"/>
          <enumerator name="CLASS_SURFACE"/>
          <enumerator name="CLASS_CLUTTER"/>
        </enum>

        <enum name="TrackAssociationDecision">
          <enumerator name="TRACK_ASSOCIATION_INITIATE"/>
          <enumerator name="TRACK_ASSOCIATION_UPDATE"/>
          <enumerator name="TRACK_ASSOCIATION_REJECT"/>
          <enumerator name="TRACK_ASSOCIATION_MERGE"/>
          <enumerator name="TRACK_ASSOCIATION_DROP"/>
        </enum>

        <enum name="TrackAssociationReason">
          <enumerator name="TRACK_ASSOCIATION_REASON_NONE"/>
          <enumerator name="TRACK_ASSOCIATION_REASON_CAPACITY"/>
          <enumerator name="TRACK_ASSOCIATION_REASON_DUPLICATE"/>
          <enumerator name="TRACK_ASSOCIATION_REASON_COAST_TIMEOUT"/>
          <enumerator name="TRACK_ASSOCIATION_REASON_RESET"/>
          <enumerator name="TRACK_ASSOCIATION_REASON_SHUTDOWN"/>
        </enum>

        <enum name="ArrayHealth">
          <enumerator name="ARRAY_NOMINAL"/>
          <enumerator name="ARRAY_DEGRADED"/>
          <enumerator name="ARRAY_CRITICAL"/>
          <enumerator name="ARRAY_OFFLINE"/>
        </enum>

        <enum name="CommandType">
          <enumerator name="CMD_SET_MODE"/>
          <enumerator name="CMD_SET_SECTOR"/>
          <enumerator name="CMD_SELF_TEST"/>
          <enumerator name="CMD_RESET"/>
          <enumerator name="CMD_DEGRADE_ARRAY"/>
          <enumerator name="CMD_RESTORE_ARRAY"/>
          <enumerator name="CMD_RMA_OFFLINE"/>
          <enumerator name="CMD_RMA_ONLINE"/>
        </enum>

        <enum name="TargetType">
          <enumerator name="TARGET_FIGHTER"/>
          <enumerator name="TARGET_BOMBER"/>
          <enumerator name="TARGET_MISSILE"/>
          <enumerator name="TARGET_SHIP"/>
          <enumerator name="TARGET_DRONE"/>
          <enumerator name="TARGET_DECOY"/>
        </enum>

        <struct name="ShipPosition" extensibility="appendable">
          <member name="source_id" type="int32" key="true"/>
          <member name="timestamp" type="nonBasic"
                  nonBasicTypeName="radar::types::TimeStamp"/>
          <member name="latitude_deg" type="float64"/>
          <member name="longitude_deg" type="float64"/>
          <member name="altitude_m" type="float64"/>
          <member name="heading_deg" type="float64"/>
          <member name="course_deg" type="float64"/>
          <member name="speed_mps" type="float64"/>
          <member name="pitch_deg" type="float64"/>
          <member name="roll_deg" type="float64"/>
        </struct>

        <struct name="BeamCommand" extensibility="appendable">
          <member name="scheduler_id" type="int32" key="true"/>
          <member name="beam_id" type="int32"/>
          <member name="timestamp"
                  type="nonBasic"
                  nonBasicTypeName="radar::types::TimeStamp"/>
          <member name="azimuth_deg" type="float64"/>
          <member name="elevation_deg" type="float64"/>
          <member name="dwell_time_us" type="int32"/>
          <member name="mode"
                  type="nonBasic"
                  nonBasicTypeName="radar::types::BeamMode"/>
          <member name="priority" type="int32"/>
        </struct>

        <!--
          Appendable prefix projection. The complete writer type continues with
          azimuth_pattern_db and RF configuration fields that view 4.2 does not
          consume.
        -->
        <struct name="BeamPatternStatus" extensibility="appendable">
          <member name="array_id" type="int32" key="true"/>
          <member name="timestamp"
                  type="nonBasic"
                  nonBasicTypeName="radar::types::TimeStamp"/>
          <member name="beam_id" type="int32"/>
          <member name="rma_offline_mask" type="int32"/>
          <member name="commanded_azimuth_deg" type="float64"/>
          <member name="boresight_error_deg" type="float64"/>
          <member name="gain_loss_db" type="float64"/>
          <member name="beamwidth_3db_deg" type="float64"/>
          <member name="peak_sidelobe_level_db" type="float64"/>
          <member name="left_sidelobe_offset_deg" type="float64"/>
          <member name="right_sidelobe_offset_deg" type="float64"/>
          <member name="pattern_start_offset_deg" type="float64"/>
          <member name="pattern_step_deg" type="float64"/>
        </struct>

        <!--
          Appendable prefix projection. The complete writer type's next and
          final member is sequence<float, 2048> iq_samples.
        -->
        <struct name="RawReturn" extensibility="appendable">
          <member name="array_id" type="int32" key="true"/>
          <member name="beam_id" type="int32"/>
          <member name="timestamp"
                  type="nonBasic"
                  nonBasicTypeName="radar::types::TimeStamp"/>
          <member name="azimuth_deg" type="float64"/>
          <member name="elevation_deg" type="float64"/>
          <member name="range_bin_count" type="int32"/>
        </struct>

        <struct name="DetectionEvent" extensibility="appendable">
          <member name="sensor_id" type="int32" key="true"/>
          <member name="detection_id" type="int32"/>
          <member name="timestamp"
                  type="nonBasic"
                  nonBasicTypeName="radar::types::TimeStamp"/>
          <member name="ship_position"
                  type="nonBasic"
                  nonBasicTypeName="radar::types::GeoPosition"/>
          <member name="range_m" type="float64"/>
          <member name="azimuth_deg" type="float64"/>
          <member name="elevation_deg" type="float64"/>
          <member name="amplitude" type="float64"/>
          <member name="snr_db" type="float64"/>
          <member name="beam_id" type="int32"/>
        </struct>

        <struct name="TargetTrack" extensibility="appendable">
          <member name="track_id" type="int32" key="true"/>
          <member name="timestamp" type="nonBasic"
                  nonBasicTypeName="radar::types::TimeStamp"/>
          <member name="position" type="nonBasic"
                  nonBasicTypeName="radar::types::Cartesian3D"/>
          <member name="velocity" type="nonBasic"
                  nonBasicTypeName="radar::types::Cartesian3D"/>
          <member name="acceleration" type="nonBasic"
                  nonBasicTypeName="radar::types::Cartesian3D"/>
          <member name="covariance" type="float64" sequenceMaxLength="9"/>
          <member name="classification" type="nonBasic"
                  nonBasicTypeName="radar::types::TrackClassification"/>
          <member name="quality" type="int32"/>
        </struct>

        <struct name="AssociationDetectionIdentity" extensibility="appendable">
          <member name="sensor_id" type="int32"/>
          <member name="detection_id" type="int32"/>
          <member name="beam_id" type="int32"/>
          <member name="timestamp" type="nonBasic"
                  nonBasicTypeName="radar::types::TimeStamp"/>
        </struct>

        <struct name="TrackAssociationEvent" extensibility="appendable">
          <member name="tracker_id" type="int32" key="true"/>
          <member name="association_id" type="int64"/>
          <member name="timestamp" type="nonBasic"
                  nonBasicTypeName="radar::types::TimeStamp"/>
          <member name="tracker_instance_id" type="int64"/>
          <member name="track_id" type="int32"/>
          <member name="track_lifecycle_id" type="int64"/>
          <member name="related_track_id" type="int32"/>
          <member name="related_track_lifecycle_id" type="int64"/>
          <member name="decision" type="nonBasic"
                  nonBasicTypeName="radar::types::TrackAssociationDecision"/>
          <member name="reason" type="nonBasic"
                  nonBasicTypeName="radar::types::TrackAssociationReason"/>
          <member name="has_measurement" type="boolean"/>
          <member name="contributing_detections" type="nonBasic"
                  nonBasicTypeName="radar::types::AssociationDetectionIdentity"
                  sequenceMaxLength="32"/>
          <member name="contributor_count" type="int32"/>
          <member name="contributors_truncated" type="boolean"/>
          <member name="fused_range_m" type="float64"/>
          <member name="fused_azimuth_deg" type="float64"/>
          <member name="fused_elevation_deg" type="float64"/>
          <member name="fused_snr_db" type="float64"/>
          <member name="innovation_score" type="float64"/>
          <member name="passing_candidate_count" type="int32"/>
          <member name="track_confirmed" type="boolean"/>
          <member name="last_accepted_sim_millis" type="int64"/>
        </struct>

        <!-- The outage mask follows element_drift_db in the appendable type,
             so this view must accept the complete 1024-value state sample. -->
        <struct name="CalibrationStatus" extensibility="appendable">
          <member name="array_id" type="int32" key="true"/>
          <member name="timestamp" type="nonBasic"
                  nonBasicTypeName="radar::types::TimeStamp"/>
          <member name="temperature_c" type="float64"/>
          <member name="element_drift_db" type="float32"
                  sequenceMaxLength="1024"/>
          <member name="overall_status" type="nonBasic"
                  nonBasicTypeName="radar::types::ArrayHealth"/>
          <member name="failed_element_count" type="int32"/>
          <member name="rma_offline_mask" type="int32"/>
        </struct>

        <struct name="SystemCommand" extensibility="appendable">
          <member name="command_id" type="int32" key="true"/>
          <member name="timestamp" type="nonBasic"
                  nonBasicTypeName="radar::types::TimeStamp"/>
          <member name="command_type" type="nonBasic"
                  nonBasicTypeName="radar::types::CommandType"/>
          <member name="sector_center_deg" type="float64"/>
          <member name="sector_width_deg" type="float64"/>
          <member name="priority" type="int32"/>
          <member name="parameters" type="string" stringMaxLength="128"/>
          <member name="target_face_mask" type="int32"/>
        </struct>

        <struct name="TargetTruth" extensibility="appendable">
          <member name="target_id" type="int32" key="true"/>
          <member name="timestamp" type="nonBasic"
                  nonBasicTypeName="radar::types::TimeStamp"/>
          <member name="position" type="nonBasic"
                  nonBasicTypeName="radar::types::Cartesian3D"/>
          <member name="velocity" type="nonBasic"
                  nonBasicTypeName="radar::types::Cartesian3D"/>
          <member name="acceleration" type="nonBasic"
                  nonBasicTypeName="radar::types::Cartesian3D"/>
          <member name="rcs_dbsm" type="float64"/>
          <member name="target_type" type="nonBasic"
                  nonBasicTypeName="radar::types::TargetType"/>
        </struct>
      </module>
    </module>
  </types>

  <qos_library name="RadarLiveViewQosLibrary">
    <qos_profile name="BestEffortVolatile">
      <datareader_qos>
        <reliability>
          <kind>BEST_EFFORT_RELIABILITY_QOS</kind>
        </reliability>
        <durability>
          <kind>VOLATILE_DURABILITY_QOS</kind>
        </durability>
        <!-- DetectionEvent offers 1 ms; RawReturn offers 0.5 ms. -->
        <latency_budget>
          <duration><sec>0</sec><nanosec>1000000</nanosec></duration>
        </latency_budget>
        <history>
          <kind>KEEP_LAST_HISTORY_QOS</kind>
          <depth>64</depth>
        </history>
        <type_consistency>
          <kind>ALLOW_TYPE_COERCION</kind>
        </type_consistency>
        <representation>
          <value>
            <element>XCDR_DATA_REPRESENTATION</element>
            <element>XCDR2_DATA_REPRESENTATION</element>
          </value>
        </representation>
      </datareader_qos>
    </qos_profile>

    <qos_profile name="BestEffortRawVolatile">
      <datareader_qos>
        <reliability><kind>BEST_EFFORT_RELIABILITY_QOS</kind></reliability>
        <durability><kind>VOLATILE_DURABILITY_QOS</kind></durability>
        <latency_budget>
          <duration><sec>0</sec><nanosec>500000</nanosec></duration>
        </latency_budget>
        <history><kind>KEEP_LAST_HISTORY_QOS</kind><depth>64</depth></history>
        <type_consistency><kind>ALLOW_TYPE_COERCION</kind></type_consistency>
        <representation><value>
          <element>XCDR_DATA_REPRESENTATION</element>
          <element>XCDR2_DATA_REPRESENTATION</element>
        </value></representation>
      </datareader_qos>
    </qos_profile>

    <qos_profile name="ReliableVolatile">
      <datareader_qos>
        <reliability>
          <kind>RELIABLE_RELIABILITY_QOS</kind>
        </reliability>
        <durability>
          <kind>VOLATILE_DURABILITY_QOS</kind>
        </durability>
        <!-- BeamCommand offers a 5 ms latency budget. -->
        <latency_budget>
          <duration><sec>0</sec><nanosec>5000000</nanosec></duration>
        </latency_budget>
        <history>
          <kind>KEEP_LAST_HISTORY_QOS</kind>
          <depth>64</depth>
        </history>
        <type_consistency>
          <kind>ALLOW_TYPE_COERCION</kind>
        </type_consistency>
        <representation>
          <value>
            <element>XCDR_DATA_REPRESENTATION</element>
            <element>XCDR2_DATA_REPRESENTATION</element>
          </value>
        </representation>
      </datareader_qos>
    </qos_profile>

    <qos_profile name="ReliableVolatile10ms">
      <datareader_qos>
        <reliability><kind>RELIABLE_RELIABILITY_QOS</kind></reliability>
        <durability><kind>VOLATILE_DURABILITY_QOS</kind></durability>
        <latency_budget>
          <duration><sec>0</sec><nanosec>10000000</nanosec></duration>
        </latency_budget>
        <history><kind>KEEP_LAST_HISTORY_QOS</kind><depth>64</depth></history>
        <type_consistency><kind>ALLOW_TYPE_COERCION</kind></type_consistency>
        <representation><value>
          <element>XCDR_DATA_REPRESENTATION</element>
          <element>XCDR2_DATA_REPRESENTATION</element>
        </value></representation>
      </datareader_qos>
    </qos_profile>

    <qos_profile name="ReliableAssociationVolatile">
      <datareader_qos>
        <reliability><kind>RELIABLE_RELIABILITY_QOS</kind></reliability>
        <durability><kind>VOLATILE_DURABILITY_QOS</kind></durability>
        <history><kind>KEEP_LAST_HISTORY_QOS</kind><depth>256</depth></history>
        <type_consistency><kind>ALLOW_TYPE_COERCION</kind></type_consistency>
        <representation><value>
          <element>XCDR_DATA_REPRESENTATION</element>
          <element>XCDR2_DATA_REPRESENTATION</element>
        </value></representation>
      </datareader_qos>
    </qos_profile>

    <qos_profile name="ReliableTransientLocal">
      <datareader_qos>
        <reliability>
          <kind>RELIABLE_RELIABILITY_QOS</kind>
        </reliability>
        <durability>
          <kind>TRANSIENT_LOCAL_DURABILITY_QOS</kind>
        </durability>
        <history>
          <kind>KEEP_LAST_HISTORY_QOS</kind>
          <depth>32</depth>
        </history>
        <type_consistency>
          <kind>ALLOW_TYPE_COERCION</kind>
        </type_consistency>
        <representation>
          <value>
            <element>XCDR_DATA_REPRESENTATION</element>
            <element>XCDR2_DATA_REPRESENTATION</element>
          </value>
        </representation>
      </datareader_qos>
    </qos_profile>

    <qos_profile name="ReliableTransientLocal10ms">
      <datareader_qos>
        <reliability><kind>RELIABLE_RELIABILITY_QOS</kind></reliability>
        <durability><kind>TRANSIENT_LOCAL_DURABILITY_QOS</kind></durability>
        <latency_budget>
          <duration><sec>0</sec><nanosec>10000000</nanosec></duration>
        </latency_budget>
        <history><kind>KEEP_LAST_HISTORY_QOS</kind><depth>32</depth></history>
        <type_consistency><kind>ALLOW_TYPE_COERCION</kind></type_consistency>
        <representation><value>
          <element>XCDR_DATA_REPRESENTATION</element>
          <element>XCDR2_DATA_REPRESENTATION</element>
        </value></representation>
      </datareader_qos>
    </qos_profile>
  </qos_library>

  <domain_library name="RadarLiveViewDomainLibrary">
    <domain name="RadarDomain92" domain_id="92">
      <register_type name="radar::types::DetectionEvent"
                     type_ref="radar::types::DetectionEvent"/>
      <register_type name="radar::types::RawReturn"
                     type_ref="radar::types::RawReturn"/>
      <register_type name="radar::types::BeamCommand"
                     type_ref="radar::types::BeamCommand"/>
      <register_type name="radar::types::BeamPatternStatus"
                     type_ref="radar::types::BeamPatternStatus"/>
      <register_type name="radar::types::ShipPosition"
                     type_ref="radar::types::ShipPosition"/>
      <register_type name="radar::types::TargetTrack"
                     type_ref="radar::types::TargetTrack"/>
      <register_type name="radar::types::TrackAssociationEvent"
                     type_ref="radar::types::TrackAssociationEvent"/>
      <register_type name="radar::types::CalibrationStatus"
                     type_ref="radar::types::CalibrationStatus"/>
      <register_type name="radar::types::SystemCommand"
                     type_ref="radar::types::SystemCommand"/>
      <register_type name="radar::types::TargetTruth"
                     type_ref="radar::types::TargetTruth"/>

      <topic name="Radar/DetectionEvent"
             register_type_ref="radar::types::DetectionEvent"/>
      <topic name="Radar/RawReturn"
             register_type_ref="radar::types::RawReturn"/>
      <topic name="Radar/BeamCommand"
             register_type_ref="radar::types::BeamCommand"/>
      <topic name="Radar/BeamPatternStatus"
             register_type_ref="radar::types::BeamPatternStatus"/>
      <topic name="Ship/ShipPosition"
             register_type_ref="radar::types::ShipPosition"/>
      <topic name="Radar/TargetTrack"
             register_type_ref="radar::types::TargetTrack"/>
      <topic name="Radar/TrackAssociationEvent"
             register_type_ref="radar::types::TrackAssociationEvent"/>
      <topic name="Radar/CalibrationStatus"
             register_type_ref="radar::types::CalibrationStatus"/>
      <topic name="Radar/SystemCommand"
             register_type_ref="radar::types::SystemCommand"/>
      <topic name="TargetGen/TargetTruth"
             register_type_ref="radar::types::TargetTruth"/>
    </domain>
  </domain_library>

  <web_integration_service name="DetectionBeamLiveView">
    <application name="RadarLiveViewApp">
      <domain_participant name="RadarParticipant"
                          domain_ref="RadarLiveViewDomainLibrary::RadarDomain92">
        <subscriber name="RadarSubscriber">
          <data_reader name="DetectionEventReader"
                       topic_ref="Radar/DetectionEvent">
            <datareader_qos
                base_name="RadarLiveViewQosLibrary::BestEffortVolatile"/>
          </data_reader>

          <data_reader name="RawReturnReader"
                       topic_ref="Radar/RawReturn">
            <datareader_qos
                base_name="RadarLiveViewQosLibrary::BestEffortRawVolatile"/>
          </data_reader>

          <data_reader name="BeamCommandReader"
                       topic_ref="Radar/BeamCommand">
            <datareader_qos
                base_name="RadarLiveViewQosLibrary::ReliableVolatile"/>
          </data_reader>

          <data_reader name="BeamPatternStatusReader"
                       topic_ref="Radar/BeamPatternStatus">
            <datareader_qos
                base_name="RadarLiveViewQosLibrary::ReliableTransientLocal"/>
          </data_reader>
        </subscriber>

        <participant_qos>
          <participant_name>
            <name>Radar.WIS-DetectionBeam</name>
          </participant_name>
          <transport_builtin>
            <mask>UDPv4</mask>
          </transport_builtin>
          <discovery>
            <initial_peers>
              <!--
                start-all creates ten local participants before WIS joins.
                Probe an explicit range instead of the implicit 0..4 range so
                launch order does not prevent discovery.
              -->
              <element>32@builtin.udpv4://127.0.0.1</element>
            </initial_peers>
          </discovery>
        </participant_qos>
      </domain_participant>
    </application>
  </web_integration_service>

  <web_integration_service name="RmaOutageImpactLiveView">
    <application name="RmaOutageApp">
      <domain_participant name="RadarParticipant"
          domain_ref="RadarLiveViewDomainLibrary::RadarDomain92">
        <subscriber name="RadarSubscriber">
          <data_reader name="SystemCommandReader" topic_ref="Radar/SystemCommand">
            <datareader_qos base_name="RadarLiveViewQosLibrary::ReliableVolatile10ms"/>
          </data_reader>
          <data_reader name="CalibrationStatusReader" topic_ref="Radar/CalibrationStatus">
            <datareader_qos base_name="RadarLiveViewQosLibrary::ReliableTransientLocal"/>
          </data_reader>
          <data_reader name="BeamPatternStatusReader" topic_ref="Radar/BeamPatternStatus">
            <datareader_qos base_name="RadarLiveViewQosLibrary::ReliableTransientLocal"/>
          </data_reader>
          <data_reader name="BeamCommandReader" topic_ref="Radar/BeamCommand">
            <datareader_qos base_name="RadarLiveViewQosLibrary::ReliableVolatile"/>
          </data_reader>
          <data_reader name="DetectionEventReader" topic_ref="Radar/DetectionEvent">
            <datareader_qos base_name="RadarLiveViewQosLibrary::BestEffortVolatile"/>
          </data_reader>
        </subscriber>
        <participant_qos>
          <participant_name><name>Radar.WIS-RmaImpact</name></participant_name>
          <transport_builtin><mask>UDPv4</mask></transport_builtin>
          <discovery><initial_peers><element>32@builtin.udpv4://127.0.0.1</element></initial_peers></discovery>
        </participant_qos>
      </domain_participant>
    </application>
  </web_integration_service>

  <web_integration_service name="AssociationDiagnosticsLiveView">
    <application name="RecordingDiagnosticsApp">
      <domain_participant name="RadarParticipant"
          domain_ref="RadarLiveViewDomainLibrary::RadarDomain92">
        <subscriber name="RadarSubscriber">
          <data_reader name="DetectionEventReader" topic_ref="Radar/DetectionEvent">
            <datareader_qos base_name="RadarLiveViewQosLibrary::BestEffortVolatile"/>
          </data_reader>
          <data_reader name="TargetTrackReader" topic_ref="Radar/TargetTrack">
            <datareader_qos base_name="RadarLiveViewQosLibrary::ReliableTransientLocal"/>
          </data_reader>
          <data_reader name="TrackAssociationEventReader" topic_ref="Radar/TrackAssociationEvent">
            <datareader_qos base_name="RadarLiveViewQosLibrary::ReliableAssociationVolatile"/>
          </data_reader>
        </subscriber>
        <participant_qos>
          <participant_name><name>Recording.DiagnosticTools</name></participant_name>
          <transport_builtin><mask>UDPv4</mask></transport_builtin>
          <discovery><initial_peers><element>32@builtin.udpv4://127.0.0.1</element></initial_peers></discovery>
        </participant_qos>
      </domain_participant>
    </application>
  </web_integration_service>

  <web_integration_service name="MotionGeometryLiveView">
    <application name="MotionGeometryApp">
      <domain_participant name="RadarParticipant"
          domain_ref="RadarLiveViewDomainLibrary::RadarDomain92">
        <subscriber name="RadarSubscriber">
          <data_reader name="ShipPositionReader" topic_ref="Ship/ShipPosition">
            <datareader_qos base_name="RadarLiveViewQosLibrary::ReliableTransientLocal10ms"/>
          </data_reader>
